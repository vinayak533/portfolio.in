# Contact form (server/contact.ts). Server-only: never prefix these with VITE_.
# Local dev: copy to .env.local (git-ignored). Production: set them in Vercel → Project → Settings → Environment Variables.

# Required. Create at https://resend.com/api-keys (permission: "Sending access").
RESEND_API_KEY=

# Optional. Where messages are delivered. Default: vinayakkv2004@gmail.com
CONTACT_TO_EMAIL=

# Optional. Sender on a domain verified in Resend, e.g. Portfolio <contact@yourdomain.com>.
# Default: Portfolio contact <onboarding@resend.dev>, which Resend only delivers to the
# email address the Resend account was created with.
CONTACT_FROM_EMAIL=
